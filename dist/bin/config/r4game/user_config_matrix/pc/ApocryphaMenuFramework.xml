<?xml version="1.0" encoding="UTF-8"?>
<!-- Apocrypha Menu Framework. Not shown in any menu: visibilityCondition="hideAlways", as the game's own NewHorseControls
     and RemasterCombat groups (its options menu leaves out only the group whose id is Hidden and the groups it reports
     invisible - the display name "hidden" alone showed an empty row in Settings, the owner's screenshot 2026-10-05).
     The framework's entry in the game's menu (Mods\modApocryphaMenuFramework) sets OpenRequest; the framework reads it,
     opens its window and clears it again. SkipIntro mirrors the framework's [Menu] bSkipIntro: the framework's script
     empties the game's list of start-up videos while it is true. SkipLoadingRecap mirrors [Menu] bSkipLoadingRecap; the
     framework's script reads it when the main menu opens and then sets DisableVideos, the engine's
     [LoadingScreen/Debug] DisableVideos (overrideGroup, as the game's own VSync switch in display.xml), which the game does
     not keep between sessions. MenuEntry (1.0.5) mirrors the framework's [Menus] bSystemMenuRow: while it is "false" the
     framework's script leaves its entry out of the game's menu. SaveSeq / SaveName / LoadSeq / LoadName / PendingLoad
     (1.0.5) are the save and load signals the framework's script leaves for the framework's per-save values: a counter
     raised after each successful save and each game start, with the save's file name ("" for a new game).
     HiddenModMenus (1.0.5) lists the menu paths of the mods placed "here only" on the framework's Settings > Mod menus,
     joined with ';'; the framework's script leaves them out of the game's Options > Mods. LoadGuard / LoadGuardSeq /
     LoadGuardBegins (1.0.6) are the loading guard's signal: the framework's script writes "loading", "game" or "menu" at
     the game's own loading and menu events and raises the counters, and the framework does nothing while a load is on. -->

<UserConfig>
	<Group id="ApocryphaMenuFramework" displayName="hidden" visibilityCondition="hideAlways">
		<VisibleVars>
			<Var id="OpenRequest" displayName="AMFOpenRequest" displayType="TOGGLE"/>
			<Var id="SkipIntro" displayName="AMFSkipIntro" displayType="TOGGLE"/>
			<Var id="SkipLoadingRecap" displayName="AMFSkipLoadingRecap" displayType="TOGGLE"/>
			<Var id="GameMenuOpen" displayName="AMFGameMenuOpen" displayType="TOGGLE"/>
			<Var id="MenuEntry" displayName="AMFMenuEntry" displayType="TOGGLE"/>
			<Var id="SaveSeq" displayName="AMFSaveSeq" displayType="TOGGLE"/>
			<Var id="SaveName" displayName="AMFSaveName" displayType="TOGGLE"/>
			<Var id="LoadSeq" displayName="AMFLoadSeq" displayType="TOGGLE"/>
			<Var id="LoadName" displayName="AMFLoadName" displayType="TOGGLE"/>
			<Var id="PendingLoad" displayName="AMFPendingLoad" displayType="TOGGLE"/>
			<Var id="HiddenModMenus" displayName="AMFHiddenModMenus" displayType="TOGGLE"/>
			<Var id="LoadGuard" displayName="AMFLoadGuard" displayType="TOGGLE"/>
			<Var id="LoadGuardSeq" displayName="AMFLoadGuardSeq" displayType="TOGGLE"/>
			<Var id="LoadGuardBegins" displayName="AMFLoadGuardBegins" displayType="TOGGLE"/>
			<Var overrideGroup="LoadingScreen/Debug" id="DisableVideos" displayName="AMFDisableLoadingVideos" displayType="TOGGLE"/>
		</VisibleVars>
	</Group>
</UserConfig>
